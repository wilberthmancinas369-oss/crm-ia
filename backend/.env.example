# Variables de entorno del backend
# Copia este archivo como backend/.env y llena los valores

### Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

### Brevo (correo para invitaciones, recomendado y gratis: 300/día a cualquier destinatario)
# Si BREVO_API_KEY tiene valor se usa Brevo; si no, Resend.
# API key en https://app.brevo.com → SMTP & API → API Keys
BREVO_API_KEY=xkeysib-your_api_key
# Correo remitente verificado en Brevo → Senders, Domains & Dedicated IPs → Senders
BREVO_SENDER_EMAIL=tucorreo@gmail.com
BREVO_SENDER_NAME=CRM con IA

### Resend (alternativa; sin dominio verificado solo envía al correo dueño de la cuenta)
# Obtén tu API Key en https://resend.com
RESEND_API_KEY=re_your_api_key
# Correo verificado en Resend desde el cual se enviarán las invitaciones
RESEND_EMAIL_FROM=onboarding@yourdomain.com

### Aplicación
# URL del frontend (Vite) para generar los links de invitación /invitacion/:token
FRONTEND_URL=http://localhost:5173
PORT=3000
