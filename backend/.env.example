# Variables de entorno del backend
# Copia este archivo como backend/.env y llena los valores

### Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

### Resend (servicio de correo para invitaciones)
# Obtén tu API Key en https://resend.com
RESEND_API_KEY=re_your_api_key
# Correo verificado en Resend desde el cual se enviarán las invitaciones
RESEND_EMAIL_FROM=onboarding@yourdomain.com

### Aplicación
# URL del frontend (Vite) para generar los links de invitación /invitacion/:token
FRONTEND_URL=http://localhost:5173
PORT=3000
